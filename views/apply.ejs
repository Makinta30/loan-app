<%- include('partials/header') %>
<div class="bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-2xl font-bold text-gray-800 mb-2">💰 Apply for a Loan</h2>
  <p class="text-sm text-gray-600 mb-6">Select your desired loan amount. We've calculated the deposit percentage you'll need to pay upfront.</p>
  
  <form method="post" action="/create-loan" class="mt-4">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
      <% categories.forEach(function(a){ 
        const deposit = a <= 50000 ? Math.ceil(a * 0.05) : (a <= 200000 ? Math.ceil(a * 0.1) : Math.ceil(a * 0.15));
      %>
        <label class="p-4 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-green-500 hover:bg-green-50 transition">
          <input type="radio" name="amount" value="<%= a %>" class="mr-2" required />
          <div>
            <strong class="text-lg text-gray-800">₦<%= a.toLocaleString() %></strong>
            <p class="text-xs text-gray-600 mt-1">Deposit: ₦<%= deposit.toLocaleString() %></p>
          </div>
        </label>
      <% }) %>
    </div>
    
    <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-green-600 to-blue-600 text-white font-bold rounded-lg hover:shadow-lg transition">
      Proceed to Payment
    </button>
    <a href="/dashboard" class="block text-center mt-3 text-sm text-gray-600 hover:text-gray-800">← Back to Dashboard</a>
  </form>
</div>
<%- include('partials/footer') %>
