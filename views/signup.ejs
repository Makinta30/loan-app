<%- include('partials/header') %>
<section class="mx-auto max-w-xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-10">
  <p class="text-sm font-semibold uppercase tracking-wider text-emerald-800">Applicant portal preview</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Create an account</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">This screen previews the future signup journey. Account creation is disabled, and this page does not accept or store your details.</p>
  <div class="mt-7 space-y-4" aria-label="Disabled signup preview">
    <label class="block text-sm font-medium text-slate-700">Full name<input disabled placeholder="Your name" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3" /></label>
    <label class="block text-sm font-medium text-slate-700">Email address<input disabled placeholder="you@example.com" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3" /></label>
    <label class="block text-sm font-medium text-slate-700">Password<input disabled type="password" placeholder="Account creation unavailable" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3" /></label>
    <button disabled class="w-full cursor-not-allowed rounded-xl bg-slate-300 px-4 py-3 font-semibold text-white">Account creation unavailable</button>
  </div>
  <p class="mt-5 text-sm text-slate-600">Already have an account? <a href="/login" class="font-semibold text-emerald-800 underline">View sign-in</a></p>
  <a href="/" class="mt-6 inline-flex text-sm font-semibold text-emerald-800 underline">Back to preview home</a>
</section>
<%- include('partials/footer') %>
