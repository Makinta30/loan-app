<%- include('partials/header') %>
<section class="mx-auto max-w-xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-10">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-800">Staff portal preview</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Admin sign-in</h1>
    </div>
    <span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-900">Preview only</span>
  </div>
  <p class="mt-4 text-sm leading-6 text-slate-600">Authentication and staff permissions have not been configured. This page does not accept credentials.</p>
  <div class="mt-7 space-y-4" aria-label="Disabled admin sign-in preview">
    <label class="block text-sm font-medium text-slate-700">Work email<input disabled placeholder="admin@yourcompany.com" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3" /></label>
    <label class="block text-sm font-medium text-slate-700">Password<input disabled type="password" placeholder="Admin sign-in unavailable" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3" /></label>
    <button disabled class="w-full cursor-not-allowed rounded-xl bg-slate-300 px-4 py-3 font-semibold text-white">Admin sign-in unavailable</button>
  </div>
  <a href="/admin" class="mt-6 inline-flex rounded-xl bg-emerald-900 px-5 py-3 font-semibold text-white hover:bg-emerald-800">View read-only dashboard preview</a>
  <a href="/" class="mt-4 block text-sm font-semibold text-emerald-800 underline">Back to preview home</a>
</section>
<%- include('partials/footer') %>
